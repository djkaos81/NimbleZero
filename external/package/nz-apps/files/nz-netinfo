#!/bin/sh
# nz-netinfo - addresses, routes, DNS and a quick reachability test.
echo "== interfaces"; ip -br addr 2>/dev/null || ip addr | grep -E '^[0-9]|inet '
echo "== default route"; ip route | grep default || echo "(none)"
echo "== DNS"; grep nameserver /etc/resolv.conf 2>/dev/null || echo "(none)"
gw=$(ip route | awk '/default/{print $3; exit}')
[ -n "$gw" ] && { echo "== ping gateway $gw"; ping -c 2 -W 2 "$gw" | tail -n 2; }
echo "== Wi-Fi"; wpa_cli -i wlan0 status 2>/dev/null | grep -E '^(ssid|wpa_state|ip_address|freq)=' || echo "(wpa_supplicant not running)"
printf "Press Enter "; read -r _
