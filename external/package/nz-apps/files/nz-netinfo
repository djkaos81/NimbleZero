#!/bin/sh
# nz-netinfo - addresses, routes, DNS and a quick reachability test.
echo "== interfaces"; ip -br addr 2>/dev/null || ip addr | grep -E '^[0-9]|inet '
echo "== default route"; ip route | grep default || echo "(none)"
echo "== DNS"; grep nameserver /etc/resolv.conf 2>/dev/null || echo "(none)"
gw=$(ip route | awk '/default/{print $3; exit}')
[ -n "$gw" ] && { echo "== ping gateway $gw"; ping -c 2 -W 2 "$gw" | tail -n 2; }
# wpa_supplicant's control socket is root-only and this app runs as the normal user;
# iw reads the link state without privileges
echo "== Wi-Fi"
if ! pidof wpa_supplicant >/dev/null 2>&1; then echo "(Wi-Fi not started)"
elif iw dev wlan0 link 2>/dev/null | grep -q '^Connected'; then
	iw dev wlan0 link | sed -n 's/^\tSSID: /ssid: /p; s/^\tfreq: /freq: /p; s/^\tsignal: /signal: /p; s/^\ttx bitrate: \([^ ]* [^ ]*\).*/rate: \1/p'
else echo "(not connected)"; fi
printf "Press Enter "; read -r _
