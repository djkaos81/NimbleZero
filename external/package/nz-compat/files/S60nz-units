#!/bin/sh
# Configuration A: start the services that packages enabled.
#  * system units recorded by the systemctl shim in /var/lib/nz-units/enabled/system
#  * user units linked in ~/.config/systemd/user/default.target.wants - this is
#    the "offline enable" path the upstream applaunch postinst uses when systemd
#    is not running - and those recorded for the user by the shim.
case "$1" in
start)
	for u in /var/lib/nz-units/enabled/system/*; do [ -e "$u" ] && nz-unit start "${u##*/}"; done
	while IFS=: read -r name _ uid _ _ home _; do
		[ "$uid" -ge 1000 ] 2>/dev/null && [ "$uid" -lt 60000 ] || continue
		for u in "$home"/.config/systemd/user/default.target.wants/* /var/lib/nz-units/enabled/user-"$uid"/*; do
			[ -e "$u" ] || [ -L "$u" ] || continue
			nz-unit --user "$uid" start "${u##*/}"
		done
	done < /etc/passwd
	;;
stop)
	for s in /run/nz-units/user/*.sup; do [ -e "$s" ] && kill "$(cat "$s")" 2>/dev/null; done
	for s in /run/nz-units/system/*.sup; do [ -e "$s" ] && kill "$(cat "$s")" 2>/dev/null; done
	;;
esac
