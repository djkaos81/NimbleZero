+static struct drm_gem_object *nz_gem_create_object(struct drm_device *drm, size_t size)
+{
+    struct drm_gem_dma_object *obj = kzalloc(sizeof(*obj), GFP_KERNEL);
+
+    if (!obj)
+        return ERR_PTR(-ENOMEM);
+    obj->map_noncoherent = nz_create_cached;
+    return &obj->base;
+}
+
