@@ -328,8 +408,80 @@
 
 static DEVICE_ATTR(reset, 0200, NULL, panel_mipi_dbi_reset_store);
 
+/* NimbleZero: timing statistics since the last read (microseconds are averages per frame) */
+static ssize_t nz_stats_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+    struct drm_device *drm = spi_get_drvdata(to_spi_device(dev));
+    struct panel_mipi_dbi_device *panel;
+    u64 n;
+    int len;
+
+    if (!drm)
+        return -ENODEV;
+    panel = to_panel_mipi_dbi_device(drm_to_mipi_dbi_dev(drm));
+    mutex_lock(&panel->display_lock);
+    n = panel->nz_st.frames ? panel->nz_st.frames : 1;
+    len = sysfs_emit(buf,
+        "path=%d native=%d te=%d te_delay_us=%d onemsg=%d madctl=0x%02x cached=%d async=%d fbdev_ms=%d buffers_cached=%llu buffers_wc=%llu\n"
+        "te_gpio=%s te_given_up=%d te_pulses=%llu te_period_us=%u\n"
+        "frames=%llu full=%llu scan_order=%llu te_waits=%llu te_timeouts=%llu async=%llu\n"
+        "avg_us: copy=%llu te_wait=%llu window=%llu burst=%llu total=%llu  max_total=%u\n",
+        nz_path, nz_native, nz_te, nz_te_delay_us, nz_onemsg, panel->nz_madctl,
+        nz_cached, nz_async, nz_fbdev_ms, nz_buffers_cached, nz_buffers_wc,
+        panel->nz_te ? "yes" : "no", panel->nz_te_off, panel->nz_te_count, panel->nz_te_period_us,
+        panel->nz_st.frames, panel->nz_st.full, panel->nz_st.native, panel->nz_st.te_waits, panel->nz_st.te_timeouts,
+        panel->nz_st.async,
+        div64_u64(panel->nz_st.copy_us, n), div64_u64(panel->nz_st.wait_us, n),
+        div64_u64(panel->nz_st.window_us, n), div64_u64(panel->nz_st.burst_us, n),
+        div64_u64(panel->nz_st.total_us, n), panel->nz_st.max_total_us);
+    memset(&panel->nz_st, 0, sizeof(panel->nz_st));
+    mutex_unlock(&panel->display_lock);
+    return len;
+}
+static DEVICE_ATTR_RO(nz_stats);
+
+/* NimbleZero: send one raw command to the panel, as hex bytes: "c6 0f" (experiments only) */
+static ssize_t nz_dcs_store(struct device *dev, struct device_attribute *attr,
+                const char *buf, size_t count)
+{
+    struct drm_device *drm = spi_get_drvdata(to_spi_device(dev));
+    struct panel_mipi_dbi_device *panel;
+    u8 b[17];
+    int n = 0, used, idx;
+    unsigned int v;
+    const char *p = buf;
+
+    if (!drm)
+        return -ENODEV;
+    while (n < (int)sizeof(b) && sscanf(p, " %x%n", &v, &used) == 1) {
+        if (v > 0xff)
+            return -EINVAL;
+        b[n++] = v;
+        p += used;
+    }
+    if (!n)
+        return -EINVAL;
+    panel = to_panel_mipi_dbi_device(drm_to_mipi_dbi_dev(drm));
+    if (!drm_dev_enter(drm, &idx))
+        return -ENODEV;
+    mutex_lock(&panel->display_lock);
+    if (n > 1)
+        mipi_dbi_command_stackbuf(&panel->dbidev.dbi, b[0], b + 1, n - 1);
+    else
+        mipi_dbi_command(&panel->dbidev.dbi, b[0]);
+    if (b[0] == MIPI_DCS_SET_ADDRESS_MODE && n > 1)
+        panel->nz_madctl = b[1];
+    panel->nz_force_full = true;
+    mutex_unlock(&panel->display_lock);
+    drm_dev_exit(idx);
+    return count;
+}
+static DEVICE_ATTR_WO(nz_dcs);
+
 static struct attribute *panel_mipi_dbi_attrs[] = {
     &dev_attr_reset.attr,
+    &dev_attr_nz_stats.attr,
+    &dev_attr_nz_dcs.attr,
     NULL,
 };
 
