+    mutex_lock(&nz_create_lock);
+    nz_create_cached = nz_cached != 0;
+    ret = drm_gem_dma_dumb_create(file, drm, args);
+    if (ret && nz_create_cached) {
+        dev_warn_once(drm->dev, "cached picture buffer failed (%d); using write-combined memory\n", ret);
