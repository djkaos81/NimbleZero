+
+    /* NimbleZero: tearing-effect (TE) sync, native-order transfer, timing statistics */
+    struct gpio_desc *nz_te;
+    int nz_te_irq;
+    struct completion nz_te_done;
+    ktime_t nz_te_last;
+    u32 nz_te_period_us;		/* time between the last two TE pulses */
+    u64 nz_te_count;
+    u8 *nz_cmd;				/* DMA-safe byte for the write-memory command */
+    u8 nz_madctl;			/* value last written to the panel */
+    bool nz_force_full;
+    /* background sender (nz_async): one frame handed over at a time */
+    struct work_struct nz_work;
+    void *nz_abuf;			/* the frame being sent; NULL: not available */
+    void *nz_dst;			/* where the current copy goes: tx_buf or nz_abuf */
+    size_t nz_alen;
+    unsigned int nz_axs, nz_axe, nz_ays, nz_aye;
+    bool nz_ate;			/* this frame waits for the TE pulse */
+    unsigned int nz_te_miss;		/* TE waits in a row that timed out */
+    bool nz_te_off;			/* no pulses seen: stop waiting until the panel is re-initialised */
+    ktime_t nz_at0;
+    u32 nz_acopy_us;
+    struct {
+        u64 frames, full, te_waits, te_timeouts, async, native;
+        u64 copy_us, wait_us, window_us, burst_us, total_us;
+        u32 max_total_us;
+    } nz_st;
 };
 
+/*
+ * NimbleZero run-time switches (/sys/module/panel_mipi_dbi_m/parameters/).
+ *   nz_path     0: the kernel's stock update path   1: the path below
+ *   nz_native   0: stock memory order (MADCTL 0xA0)
+ *               1..4: send the frame in the panel's own scan order (MADCTL 0x00), rotating
+ *                     it in software; the four values are the four possible orientations
+ *   nz_te       1: start every full frame on the panel's TE pulse (needs te-gpios)
+ *   nz_te_delay_us  wait this long after the pulse before sending pixels
+ *   nz_onemsg   1: send the pixel data as one SPI message (0: one message per chunk)
+ */
+static int nz_path;
+module_param(nz_path, int, 0644);
+static int nz_native;
+module_param(nz_native, int, 0644);
+static int nz_te;
+module_param(nz_te, int, 0644);
+static int nz_te_delay_us;
+module_param(nz_te_delay_us, int, 0644);
+static int nz_onemsg = 1;
+module_param(nz_onemsg, int, 0644);
+/*   nz_cached   1: picture buffers created from now on live in ordinary cached memory (default 0)
+ *               0: write-combined memory as in the vendor driver (reading a frame back
+ *                  out of it took 7-9 ms per frame on hardware, 2026-11-19)
+ * Takes effect for buffers created after the change (each program start). */
+static int nz_cached;
+module_param(nz_cached, int, 0644);
+/*   nz_async    1: with nz_native and nz_te on, a full frame is copied and handed to a
+ *                  background sender; the update call returns at once, so the program can
+ *                  draw its next frame while this one waits for the TE pulse and is sent.
+ *                  The next update waits until the previous frame has gone out. */
+static int nz_async;
+module_param(nz_async, int, 0644);
+#define NZ_ABUF_SIZE	(320 * 240 * 2)
+/*   nz_fbdev_ms  how long the console framebuffer layer (/dev/fb0: launcher, console, most
+ *                apps) collects changes before it passes them on.  0: the kernel's value
+ *                (50 ms = at most 20 updates per second).  Example: 16. */
+static int nz_fbdev_ms;
+module_param(nz_fbdev_ms, int, 0644);
+/* Updates in panel scan order that cover at least 1/NZ_TE_FRACTION of the screen start on
+ * the TE pulse; smaller ones (cursor, clock) are sent at once. */
+#define NZ_TE_FRACTION	16
+static u64 nz_buffers_cached, nz_buffers_wc;	/* picture buffers created so far, by kind */
+
+#define NZ_MADCTL_STOCK	0xA0
+#define NZ_MADCTL_NATIVE	0x00
+
 static inline struct panel_mipi_dbi_device *
 to_panel_mipi_dbi_device(struct mipi_dbi_dev *dbidev)
 {
@@ -276,13 +357,12 @@
