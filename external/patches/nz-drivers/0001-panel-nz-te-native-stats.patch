-        mipi_dbi_command(dbi, MIPI_DCS_SET_TEAR_ON,
-                 MIPI_DCS_TEAR_MODE_VBLANK);
-    */
+    panel->nz_madctl = NZ_MADCTL_STOCK;
+    panel->nz_force_full = true;
+    /* the tear mode is cheap to set and may have been lost with a reset */
+    if (panel->nz_te)
+        mipi_dbi_command(dbi, 0x35 /* tearing effect line on */, 0x00 /* at vertical blanking */);
 
     mipi_dbi_enable_flush(dbidev, crtc_state, plane_state);
 out_exit:
@@ -407,15 +557,316 @@
     drm_dev_exit(idx);
 }
 
+/* ---- NimbleZero update path -------------------------------------------------------- */
+
+static irqreturn_t nz_te_isr(int irq, void *data)
+{
+    struct panel_mipi_dbi_device *panel = data;
+    ktime_t now = ktime_get();
+
+    s64 d = ktime_us_delta(now, panel->nz_te_last);
+
+    if (d > 0 && d < 100000)		/* longer gaps: panel was being re-initialised */
+        panel->nz_te_period_us = (u32)d;
+    panel->nz_te_last = now;
+    panel->nz_te_count++;
+    complete(&panel->nz_te_done);
+    return IRQ_HANDLED;
+}
+
+/*
+ * Copy part of the RGB565 framebuffer (320x170, as the applications see it) into the
+ * transfer buffer in the panel's own order (big-endian): panel lines run along the
+ * framebuffer's x axis, pixels within a line along its y axis.  variant 1..4 selects
+ * which way the two axes run.  Returns the panel window (line r0..r1, pixel c0..c1).
+ */
+static void nz_copy_native(struct panel_mipi_dbi_device *panel, const struct iosys_map *src,
+               struct drm_framebuffer *fb, const struct drm_rect *rect, int variant,
+               unsigned int *r0, unsigned int *r1, unsigned int *c0, unsigned int *c1)
+{
+    const u8 *base = src->vaddr + fb->offsets[0];
+    unsigned int W = fb->width, H = fb->height, pitch = fb->pitches[0];
+    bool flipx = variant == 2 || variant == 4, flipy = variant == 3 || variant == 4;
+    u16 *dst = panel->nz_dst;
+    unsigned int r, c;
+
+    *r0 = flipx ? W - rect->x2 : rect->x1;
+    *r1 = flipx ? W - 1 - rect->x1 : rect->x2 - 1;
+    *c0 = flipy ? H - rect->y2 : rect->y1;
+    *c1 = flipy ? H - 1 - rect->y1 : rect->y2 - 1;
+
+    for (r = *r0; r <= *r1; r++) {
+        unsigned int x = flipx ? W - 1 - r : r;
+
+        for (c = *c0; c <= *c1; c++) {
+            unsigned int y = flipy ? H - 1 - c : c;
+
+            *dst++ = swab16(*(const u16 *)(base + y * pitch + x * 2));
+        }
+    }
+}
+
+/* Pixel data: command byte, then the buffer, as one SPI message (or chunk by chunk). */
+static int nz_write_memory(struct panel_mipi_dbi_device *panel, const void *buf, size_t len)
+{
+    struct mipi_dbi *dbi = &panel->dbidev.dbi;
+    struct spi_device *spi = dbi->spi;
+    size_t max_chunk = ALIGN_DOWN(spi_max_transfer_size(spi), 2);
+    struct spi_transfer tr[4] = { };
+    struct spi_message m;
+    int ret, n = 0;
+
+    if (!nz_onemsg || DIV_ROUND_UP(len, max_chunk) > ARRAY_SIZE(tr))
+        return mipi_dbi_command_buf(dbi, MIPI_DCS_WRITE_MEMORY_START, (u8 *)buf, len);
+
+    mutex_lock(&dbi->cmdlock);
+    spi_bus_lock(spi->controller);
+    panel->nz_cmd[0] = MIPI_DCS_WRITE_MEMORY_START;
+    gpiod_set_value_cansleep(dbi->dc, 0);
+    ret = mipi_dbi_spi_transfer(spi, mipi_dbi_spi_cmd_max_speed(spi, 1), 8, panel->nz_cmd, 1);
+    if (ret)
+        goto out;
+    gpiod_set_value_cansleep(dbi->dc, 1);
+    spi_message_init(&m);
+    while (len) {
+        size_t chunk = min(len, max_chunk);
+
+        tr[n].tx_buf = buf;
+        tr[n].len = chunk;
+        tr[n].bits_per_word = 8;
+        spi_message_add_tail(&tr[n], &m);
+        buf += chunk;
+        len -= chunk;
+        n++;
+    }
+    ret = spi_sync_locked(spi, &m);
+out:
+    spi_bus_unlock(spi->controller);
+    mutex_unlock(&dbi->cmdlock);
+    return ret;
+}
+
+/* Wait for the next TE pulse.  A device whose TE line is not connected (or a panel that
+ * does not drive it) would cost 60 ms per frame here; after five misses in a row the
+ * driver stops waiting and sends unsynchronised until the panel is re-initialised. */
+static bool nz_wait_te(struct panel_mipi_dbi_device *panel)
+{
+    if (panel->nz_te_off)
+        return false;
+    reinit_completion(&panel->nz_te_done);
+    panel->nz_st.te_waits++;
+    if (wait_for_completion_timeout(&panel->nz_te_done, msecs_to_jiffies(60))) {
+        panel->nz_te_miss = 0;
+        return true;
+    }
+    panel->nz_st.te_timeouts++;
+    if (++panel->nz_te_miss >= 5) {
+        panel->nz_te_off = true;
+        dev_warn(panel->dbidev.drm.dev, "no pulses on the TE pin; sending without synchronisation\n");
+    }
+    return false;
+}
+
+/* Background sender: waits for the TE pulse and sends the frame in nz_abuf.  It holds
+ * display_lock like every other user of the panel; updates wait for it with flush_work()
+ * BEFORE taking that lock. */
+static void nz_send_work(struct work_struct *work)
+{
+    struct panel_mipi_dbi_device *panel = container_of(work, struct panel_mipi_dbi_device, nz_work);
+    struct mipi_dbi *dbi = &panel->dbidev.dbi;
+    ktime_t t1, t2, t3, t4;
+    u32 total;
+    int idx, ret;
+
+    if (!drm_dev_enter(&panel->dbidev.drm, &idx))
+        return;
+    mutex_lock(&panel->display_lock);
+    /* the panel was reset or switched back since the hand-over: drop this frame, the
+     * next update is a forced full one */
+    if (panel->nz_madctl != NZ_MADCTL_NATIVE || !panel->nz_alen || panel->nz_alen > NZ_ABUF_SIZE)
+        goto out;
+    t1 = ktime_get();
+    if (panel->nz_ate)
+        nz_wait_te(panel);
+    t2 = ktime_get();
+    mipi_dbi_command(dbi, MIPI_DCS_SET_COLUMN_ADDRESS, panel->nz_axs >> 8, panel->nz_axs & 0xff,
+             panel->nz_axe >> 8, panel->nz_axe & 0xff);
+    mipi_dbi_command(dbi, MIPI_DCS_SET_PAGE_ADDRESS, panel->nz_ays >> 8, panel->nz_ays & 0xff,
+             panel->nz_aye >> 8, panel->nz_aye & 0xff);
+    t3 = ktime_get();
+    ret = nz_write_memory(panel, panel->nz_abuf, panel->nz_alen);
+    t4 = ktime_get();
+    if (ret)
+        drm_err_once(&panel->dbidev.drm, "Failed to update display %d\n", ret);
+
+    panel->nz_st.frames++;
+    panel->nz_st.full += panel->nz_alen == (size_t)panel->dbidev.mode.hdisplay * panel->dbidev.mode.vdisplay * 2;
+    panel->nz_st.native++;
+    panel->nz_st.async++;
+    panel->nz_st.copy_us += panel->nz_acopy_us;
+    panel->nz_st.wait_us += ktime_us_delta(t2, t1);
+    panel->nz_st.window_us += ktime_us_delta(t3, t2);
+    panel->nz_st.burst_us += ktime_us_delta(t4, t3);
+    total = (u32)ktime_us_delta(t4, panel->nz_at0);	/* hand-over to last pixel */
+    panel->nz_st.total_us += total;
+    if (total > panel->nz_st.max_total_us)
+        panel->nz_st.max_total_us = total;
+out:
+    panel->nz_alen = 0;
+    mutex_unlock(&panel->display_lock);
+    drm_dev_exit(idx);
+}
+
+static void nz_fb_dirty(struct panel_mipi_dbi_device *panel, struct iosys_map *src,
+            struct drm_framebuffer *fb, struct drm_rect *rect,
+            struct drm_format_conv_state *fmtcnv_state)
+{
+    struct mipi_dbi_dev *dbidev = &panel->dbidev;
+    struct mipi_dbi *dbi = &dbidev->dbi;
+    int native = fb->format->format == DRM_FORMAT_RGB565 ? nz_native : 0;
+    u8 madctl = native ? NZ_MADCTL_NATIVE : NZ_MADCTL_STOCK;
+    ktime_t t0 = ktime_get(), t1, t2, t3, t4;
+    unsigned int xs, xe, ys, ye;
+    bool full, async, te_sync;
+    unsigned int r0, r1, c0, c1;
+    size_t len;
+    u32 total;
+    int ret = 0;
+
+    if (native < 0 || native > 4)
+        native = 0;
+    async = nz_async && native && panel->nz_abuf &&
+        (size_t)fb->width * fb->height * 2 <= NZ_ABUF_SIZE;
+    panel->nz_dst = async ? panel->nz_abuf : dbidev->tx_buf;
+    if (madctl != panel->nz_madctl) {
+        mipi_dbi_command(dbi, MIPI_DCS_SET_ADDRESS_MODE, madctl);
+        panel->nz_madctl = madctl;
+        panel->nz_force_full = true;
+    }
+    if (panel->nz_force_full) {
+        rect->x1 = 0; rect->y1 = 0; rect->x2 = fb->width; rect->y2 = fb->height;
+        panel->nz_force_full = false;
+    }
+    full = drm_rect_width(rect) == fb->width && drm_rect_height(rect) == fb->height;
+
+    if (native) {
+        ret = drm_gem_fb_begin_cpu_access(fb, DMA_FROM_DEVICE);
+        if (ret)
+            goto err;
+        nz_copy_native(panel, src, fb, rect, native, &r0, &r1, &c0, &c1);
+        drm_gem_fb_end_cpu_access(fb, DMA_FROM_DEVICE);
+        /* panel memory: 240 columns, the glass shows 170 of them starting at top_offset */
+        xs = dbidev->top_offset + c0; xe = dbidev->top_offset + c1;
+        ys = dbidev->left_offset + r0; ye = dbidev->left_offset + r1;
+        len = (size_t)(r1 - r0 + 1) * (c1 - c0 + 1) * 2;
+        panel->nz_st.native += !async;
+    } else {
+        ret = mipi_dbi_buf_copy(dbidev->tx_buf, src, fb, rect, true, fmtcnv_state);
+        if (ret)
+            goto err;
+        xs = rect->x1 + dbidev->left_offset; xe = rect->x2 - 1 + dbidev->left_offset;
+        ys = rect->y1 + dbidev->top_offset; ye = rect->y2 - 1 + dbidev->top_offset;
+        len = (size_t)drm_rect_width(rect) * drm_rect_height(rect) * 2;
+    }
+    t1 = ktime_get();
+    /* In scan order a write that starts on the TE pulse stays ahead of the panel's own
+     * scan wherever it begins, so partial updates can be synchronised too. */
+    te_sync = nz_te && panel->nz_te &&
+          (native ? len * NZ_TE_FRACTION >= (size_t)fb->width * fb->height * 2 : full);
+
+    if (async) {
+        /* hand the frame to the background sender and return */
+        panel->nz_axs = xs; panel->nz_axe = xe; panel->nz_ays = ys; panel->nz_aye = ye;
+        panel->nz_alen = len;
+        panel->nz_ate = te_sync;
+        panel->nz_at0 = t0;
+        panel->nz_acopy_us = (u32)ktime_us_delta(t1, t0);
