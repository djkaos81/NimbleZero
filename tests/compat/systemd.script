# Configuration B (real systemd): the upstream packages use systemd directly.
mount debs :: : > /run/nz/nolauncher; killall nz-launcher nz-diag 2>/dev/null; modprobe usb-storage; sleep 6; mkdir -p /mnt && mount -o ro /dev/sda /mnt && ls /mnt | wc -l
S1 system state :: systemctl is-system-running; systemctl --failed --no-legend | head -n 8; systemctl list-units --type=service --state=running --no-legend | wc -l
S2 install APPLaunch 0.6.105; upstream postinst takes its systemd path (linger, user manager, enable, start) :: apt-get install -y /mnt/applaunch_0.6.105-m5stack1_arm64.deb 2>&1 | tail -n 4; [ "$(dpkg-query -W -f='${Version}' applaunch)" = 0.6.105 ] && loginctl show-user cardputer --property=Linger
Q1 (emulator substitution) keyboard alias :: mkdir -p /dev/input/by-path; ln -sf /dev/input/event0 /dev/input/by-path/platform-3f804000.i2c-event; systemctl stop nz-console-tty1.service; echo 0 > /sys/class/vtconsole/vtcon1/bind; runuser -u cardputer -- env XDG_RUNTIME_DIR=/run/user/1000 systemctl --user restart APPLaunch.service; sleep 25; true
S3 APPLaunch is an active systemd user service running as UID 1000 :: runuser -u cardputer -- env XDG_RUNTIME_DIR=/run/user/1000 systemctl --user is-active APPLaunch.service && p=$(runuser -u cardputer -- env XDG_RUNTIME_DIR=/run/user/1000 systemctl --user show APPLaunch.service --property=MainPID --value) && echo "pid=$p exe=$(readlink /proc/$p/exe)" && [ "$(readlink /proc/$p/exe)" = /usr/share/APPLaunch/bin/M5CardputerZero-APPLaunch ]
@shot applaunch-systemd-home
S4 upstream updater unit is known to systemd (not started: it would download from GitHub) :: systemctl cat applaunch-updater.service | grep ExecStart && systemctl is-enabled applaunch-updater.service; true
S5 upgrade to 0.6.106 restarts the service through systemd :: p1=$(runuser -u cardputer -- env XDG_RUNTIME_DIR=/run/user/1000 systemctl --user show APPLaunch.service --property=MainPID --value); apt-get install -y /mnt/applaunch_0.6.106-m5stack1_arm64.deb 2>&1 | tail -n 2; sleep 20; p2=$(runuser -u cardputer -- env XDG_RUNTIME_DIR=/run/user/1000 systemctl --user show APPLaunch.service --property=MainPID --value); echo "$p1 -> $p2"; [ "$(dpkg-query -W -f='${Version}' applaunch)" = 0.6.106 ] && [ "$p1" != "$p2" ] && [ "$(readlink /proc/$p2/exe)" = /usr/share/APPLaunch/bin/M5CardputerZero-APPLaunch ]
@shot applaunch-systemd-0.6.106
S6 journal has the service output :: journalctl --no-pager -n 6 _UID=1000 | tail -n 6; true
S7 measurements with APPLaunch running :: nz-perf -i 10 > /tmp/perf-applaunch.json; grep -E 'mem_used_kb|userspace_pss_kb|processes_user"|cpu_idle_pct|context_switches' /tmp/perf-applaunch.json
S8 uninstall :: dpkg -r applaunch 2>&1 | tail -n 2; [ ! -e /usr/share/APPLaunch/bin/M5CardputerZero-APPLaunch ]
